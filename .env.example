# Supabase (used by the Next.js app / API routes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection string (used ONLY by the Python scraper, e.g. in
# GitHub Actions as the SUPABASE_DB_URL secret).
# Use the pooler format from Supabase Dashboard > Database > Connection string > Connection pooling:
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# URL-encode special characters in the password (e.g. @ -> %40).
# (Do not put this in a browser-exposed variable. It is never read by the Next.js app.)
# SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
